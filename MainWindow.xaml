<Window x:Class="MAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MAI"
        mc:Ignorable="d"
        Title="Метод аналізу ієрархій Томаса Сааті (МАІ / AHP)" 
        Height="810" Width="1080"
        MinHeight="650" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/app_icon.ico"
        Background="{DynamicResource AppBackground}">

    <DockPanel>
        <!-- Top Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="8,4" FontSize="13">
            <!-- Menu "Файл" -->
            <MenuItem Header="_Файл">
                <MenuItem Header="_Зберегти задачу як..." InputGestureText="Ctrl+S" Click="MenuFileSaveAs_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="💾" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="За_вантажити задачу..." InputGestureText="Ctrl+O" Click="MenuFileOpen_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="📂" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Експорт звіту в TXT..." InputGestureText="Ctrl+E" Click="MenuFileExportReport_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="📋" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Ви_хід" InputGestureText="Alt+F4" Click="MenuFileExit_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="❌" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- Menu "Налаштування" -->
            <MenuItem Header="_Налаштування">
                <MenuItem Header="_Профіль розрахунку">
                    <MenuItem.Icon>
                        <TextBlock Text="🎯" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </MenuItem.Icon>
                    <MenuItem x:Name="MenuProfileLab4" Header="🔬 Еталон ЛР №4" IsCheckable="True" IsChecked="True" Click="MenuProfileLab4_Click"/>
                    <MenuItem x:Name="MenuProfileClassic" Header="🏛️ Класичний метод Т. Сааті" IsCheckable="True" IsChecked="False" Click="MenuProfileClassic_Click"/>
                    <MenuItem x:Name="MenuProfileCustom" Header="⚙️ Власний профіль (Custom)" IsCheckable="True" IsChecked="False" IsEnabled="False"/>
                    <Separator/>
                    <MenuItem Header="Метод розрахунку ваг">
                        <MenuItem x:Name="MenuWeightColumnNorm" Header="Нормалізація стовпців (Column Normalization)" IsCheckable="True" Click="MenuWeightColumnNorm_Click"/>
                        <MenuItem x:Name="MenuWeightGeometric" Header="Геометричне середнє (Geometric Mean / LLSM)" IsCheckable="True" Click="MenuWeightGeometric_Click"/>
                        <MenuItem x:Name="MenuWeightPowerIteration" Header="Степеневий метод (Power Iteration / Сааті)" IsCheckable="True" Click="MenuWeightPowerIteration_Click"/>
                    </MenuItem>
                    <MenuItem Header="Метод власного значення (λmax)">
                        <MenuItem x:Name="MenuLambdaColSum" Header="Добуток сум стовпців: Σ(ColSum_j · w_j) [ЛР №4]" IsCheckable="True" Click="MenuLambdaColSum_Click"/>
                        <MenuItem x:Name="MenuLambdaExact" Header="Точне власне значення: (A·w)_i / w_i [Сааті]" IsCheckable="True" Click="MenuLambdaExact_Click"/>
                    </MenuItem>
                    <MenuItem Header="Індекс випадкової узгодженості (RI)">
                        <MenuItem x:Name="MenuRiEmpirical" Header="Емпірична формула: 1.98 · (n-2) / n" IsCheckable="True" Click="MenuRiEmpirical_Click"/>
                        <MenuItem x:Name="MenuRiTable" Header="Табличне значення Сааті (RI table)" IsCheckable="True" Click="MenuRiTable_Click"/>
                    </MenuItem>
                    <MenuItem Header="Поріг узгодженості (CR max)">
                        <MenuItem x:Name="MenuThresholdUniform" Header="Фіксований 10% для всіх n (ЛР №4)" IsCheckable="True" Click="MenuThresholdUniform_Click"/>
                        <MenuItem x:Name="MenuThresholdAdaptive" Header="Адаптивний Сааті (5% при n=3, 8% при n=4, 10% при n≥5)" IsCheckable="True" Click="MenuThresholdAdaptive_Click"/>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="_Тема оформлення">
                    <MenuItem.Icon>
                        <TextBlock Text="🎨" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </MenuItem.Icon>
                    <MenuItem x:Name="MenuThemeLight" Header="☀️ Світла" IsCheckable="True" IsChecked="True" Click="MenuThemeLight_Click"/>
                    <MenuItem x:Name="MenuThemeDark" Header="🌙 Темна" IsCheckable="True" IsChecked="False" Click="MenuThemeDark_Click"/>
                </MenuItem>
            </MenuItem>

            <!-- Menu "Довідка" -->
            <MenuItem Header="_Довідка">
                <MenuItem Header="_Про програму" InputGestureText="F1" Click="MenuHelpAbout_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="ℹ️" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <Grid Margin="20,12,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header & Presets -->
                <RowDefinition Height="*"/>    <!-- Main Navigation Tabs -->
                <RowDefinition Height="Auto"/> <!-- Bottom Action Bar -->
            </Grid.RowDefinitions>

        <!-- Top Header & Presets Bar -->
        <Border Grid.Row="0" CornerRadius="12" Padding="20,16" Margin="0,0,0,16" BorderThickness="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#0F172A" Opacity="0.04"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource BadgeBg}" CornerRadius="6" Padding="6,4" Margin="0,2,8,0">
                            <TextBlock Text="AHP • МАІ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BadgeFg}"/>
                        </Border>
                        <TextBlock Text="Метод аналізу ієрархій Томаса Сааті" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextDark}"/>
                        <Border x:Name="BadgeActiveProfile" Background="{DynamicResource PillConsistentBg}" BorderBrush="{DynamicResource PillConsistentBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="6,4,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtActiveProfile" Text="Профіль: ЛР №4" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PillConsistentFg}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Системний аналіз та теорія прийняття рішень • .NET 10 WPF Application" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Preset Toolbar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnPresetLab34" Content="📁 Тестовий набір №1" Style="{StaticResource SecondaryBtnStyle}" Margin="0,0,8,0" Click="BtnPresetLab34_Click"/>
                    <Button x:Name="BtnPresetCoursework" Content="📘 Тестовий набір №2" Style="{StaticResource SecondaryBtnStyle}" Margin="0,0,8,0" Click="BtnPresetCoursework_Click"/>
                    <Button x:Name="BtnResetEmpty" Content="🔄 Нова задача" Style="{StaticResource SecondaryBtnStyle}" Click="BtnResetEmpty_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Navigation Tabs -->
        <TabControl Grid.Row="1" x:Name="MainTabControl" Background="Transparent" BorderThickness="0" Margin="0,0,0,10" SelectionChanged="MainTabControl_SelectionChanged">
            <!-- TAB 1: Критерії та Альтернативи -->
            <TabItem Header="1. Критерії та Альтернативи">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Criteria Management Card -->
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Критерії оцінювання" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextDark}"/>
                                        <TextBlock x:Name="TxtCritCount" Text="(4)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBlue}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="Визначте параметри, за якими здійснюється вибір (2..8)." FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"/>

                                    <DataGrid x:Name="GridCriteria" Height="190" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                                              HeadersVisibility="Column" RowHeaderWidth="0"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Назва критерію" Binding="{Binding Name}" Width="Auto" MinWidth="140">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                        <Setter Property="ToolTip" Value="{Binding Name}"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Опис / Зміст" Binding="{Binding Description}" Width="Auto" MinWidth="240">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                        <Setter Property="ToolTip" Value="{Binding Description}"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button Content="➕ Додати критерій" Style="{StaticResource SecondaryBtnStyle}" Margin="0,0,8,0" Click="BtnAddCriterion_Click"/>
                                        <Button Content="❌ Видалити" Style="{StaticResource SecondaryBtnStyle}" Click="BtnRemoveCriterion_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Alternatives Management Card -->
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Альтернативи вибору" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextDark}"/>
                                        <TextBlock x:Name="TxtAltCount" Text="(5)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBlue}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="Варіанти розв'язку або об'єкти вибору (2..8)." FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"/>

                                    <DataGrid x:Name="GridAlternatives" Height="190" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                                              HeadersVisibility="Column" RowHeaderWidth="0"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Назва альтернативи" Binding="{Binding Name}" Width="Auto" MinWidth="160">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                        <Setter Property="ToolTip" Value="{Binding Name}"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Опис / Специфікація" Binding="{Binding Description}" Width="Auto" MinWidth="240">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                        <Setter Property="ToolTip" Value="{Binding Description}"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button Content="➕ Додати альтернативу" Style="{StaticResource SecondaryBtnStyle}" Margin="0,0,8,0" Click="BtnAddAlternative_Click"/>
                                        <Button Content="❌ Видалити" Style="{StaticResource SecondaryBtnStyle}" Click="BtnRemoveAlternative_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Saaty Scale Reference Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Довідка: Фундаментальна 9-бальна шкала важливості Сааті" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextDark}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="• 1 — Однакова важливість (рівні умови)" FontSize="12" Foreground="{DynamicResource TextDark}" Margin="0,2"/>
                                        <TextBlock Text="• 3 — Помірна перевага одного над іншим" FontSize="12" Foreground="{DynamicResource TextDark}" Margin="0,2"/>
                                        <TextBlock Text="• 5 — Суттєва (сильна) перевага" FontSize="12" Foreground="{DynamicResource TextDark}" Margin="0,2"/>
                                        <TextBlock Text="• 7 — Значна (очевидна) перевага" FontSize="12" Foreground="{DynamicResource TextDark}" Margin="0,2"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="• 9 — Абсолютна (найвища можлива) перевага" FontSize="12" Foreground="{DynamicResource TextDark}" Margin="0,2"/>
                                        <TextBlock Text="• 2, 4, 6, 8 — Проміжні компромісні градації" FontSize="12" Foreground="{DynamicResource TextDark}" Margin="0,2"/>
                                        <TextBlock Text="• 1/2, 1/3, ..., 1/9 — Обернені оцінки (перевага стовпця над рядком)" FontSize="12" Foreground="{DynamicResource TextDark}" Margin="0,2"/>
                                        <TextBlock Text="💡 Порада: вводьте числа або дроби (наприклад 3 або 1/3). Симетричні клітинки заповнюються автоматично." FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBlue}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: Порівняння критеріїв -->
            <TabItem Header="2. Порівняння критеріїв">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,0">
                    <StackPanel>
                        <!-- Criteria Matrix Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Матриця попарних порівнянь критеріїв" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextDark}"/>
                                        <TextBlock Text="Вкажіть перевагу критерію в лівому рядку над критерієм у верхньому стовпці." FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>

                                    <!-- Quick Status Pill -->
                                    <Border Grid.Column="1" x:Name="PillCritStatus" Background="{DynamicResource PillConsistentBg}" BorderBrush="{DynamicResource PillConsistentBorder}" BorderThickness="1" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtCritStatus" Text="Узгоджено (CR = 1.7% ≤ 10%)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PillConsistentFg}"/>
                                    </Border>
                                </Grid>

                                <!-- Dynamic Matrix Container -->
                                <Border Background="{DynamicResource MatrixContainerBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <Grid x:Name="GridCritMatrixContainer"/>
                                    </ScrollViewer>
                                </Border>

                                <!-- Live Weights & Diagnostics -->
                                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Розраховані ваги критеріїв (Вектор w):" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextDark}" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="TxtCritWeightsPreview" Text="w = [P: 0.365, F: 0.234, A: 0.124, C: 0.278]" FontSize="13" Foreground="{DynamicResource PrimaryBlue}" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" TextBlock.TextAlignment="Right">
                                            <TextBlock x:Name="TxtCritLambdaCI" Text="λmax = 4.0458 | CI = 0.0153" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock x:Name="TxtCritRIRatio" Text="RI(табл) = 0.90 | CR = 0.0170 (1.7%)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessGreen}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: Оцінка альтернатив -->
            <TabItem Header="3. Оцінка альтернатив">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Матриці попарних порівнянь альтернатив" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextDark}"/>
                                        <TextBlock Text="Оберіть критерій та заповніть попарні оцінки альтернатив за ним." FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>

                                    <!-- Quick Status Pill for Alternative Matrix -->
                                    <Border Grid.Column="1" x:Name="PillAltStatus" Background="{DynamicResource PillConsistentBg}" BorderBrush="{DynamicResource PillConsistentBorder}" BorderThickness="1" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtAltStatus" Text="Узгоджено (CR = 2.6%)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PillConsistentFg}"/>
                                    </Border>
                                </Grid>

                                <!-- Criteria Tab Strip for Alternatives -->
                                <WrapPanel x:Name="PanelCritSelectors" Margin="0,0,0,12"/>

                                <!-- Dynamic Matrix Container for Alternatives -->
                                <Border Background="{DynamicResource MatrixContainerBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <Grid x:Name="GridAltMatrixContainer"/>
                                    </ScrollViewer>
                                </Border>

                                <!-- Live Local Priorities for selected criterion -->
                                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="TxtAltLocalPriTitle" Text="Локальні пріоритети альтернатив за обраним критерієм:" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextDark}" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="TxtAltLocalPriPreview" Text="A1: 0.045, A2: 0.139, A3: 0.213, A4: 0.278, A5: 0.325" FontSize="13" Foreground="{DynamicResource PrimaryBlue}" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" TextBlock.TextAlignment="Right">
                                            <TextBlock x:Name="TxtAltLambdaCI" Text="λmax = 5.1248 | CI = 0.0312" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock x:Name="TxtAltRIRatio" Text="RI = 1.12 | CR = 0.0278 (2.8%)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessGreen}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="16,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#0F172A" Opacity="0.04"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtBottomStatus" Text="Готово до розрахунку: 4 критерії, 5 альтернатив." FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}"/>
                    <TextBlock x:Name="TxtActiveProfileDesc" Text="Профіль: Еталон ЛР №4 • Нормалізація стовпців • Σ(ColSum_j · w_j) • Емпіричний RI • CR ≤ 10%" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>

                <Button Grid.Column="1" Content="🚀 Розрахувати та показати результати" Style="{StaticResource PrimaryBtnStyle}" Height="38" Padding="20,0" FontSize="14" Click="BtnCalculate_Click"/>
            </Grid>
        </Border>
    </Grid>
    </DockPanel>
</Window>
