<Window x:Class="MAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MAI"
        mc:Ignorable="d"
        Title="{DynamicResource Str_Main_Title}" 
        Height="810" Width="1080"
        MinHeight="650" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/app_icon.ico"
        Background="{DynamicResource AppBackground}">

    <Window.Resources>
        <Style x:Key="DataGridCellEditorTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDark}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBlue}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextDark}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Top Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="8,4" FontSize="13">
            <!-- Menu "Файл" -->
            <MenuItem Header="{DynamicResource Str_Menu_File}">
                <MenuItem Header="{DynamicResource Str_Menu_SaveAs}" InputGestureText="Ctrl+S" Click="MenuFileSaveAs_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="💾" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Str_Menu_Open}" InputGestureText="Ctrl+O" Click="MenuFileOpen_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="📂" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{DynamicResource Str_Menu_Presets}">
                    <MenuItem.Icon>
                        <TextBlock Text="📚" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </MenuItem.Icon>
                    <MenuItem Header="{DynamicResource Str_Menu_Preset1}" Click="BtnPresetReference_Click"/>
                    <MenuItem Header="{DynamicResource Str_Menu_Preset2}" Click="BtnPresetGpu2026_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{DynamicResource Str_Menu_ExportReport}" InputGestureText="Ctrl+E" Click="MenuFileExportReport_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="📋" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{DynamicResource Str_Menu_Exit}" InputGestureText="Alt+F4" Click="MenuFileExit_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="❌" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- Menu "Налаштування" -->
            <MenuItem Header="{DynamicResource Str_Menu_Settings}">
                <MenuItem Header="{DynamicResource Str_Menu_CompareProfiles}" InputGestureText="Ctrl+P" Click="MenuCompareProfiles_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="⚖️" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{DynamicResource Str_Menu_Profile}">
                    <MenuItem.Icon>
                        <TextBlock Text="🎯" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </MenuItem.Icon>
                    <MenuItem x:Name="MenuProfileMethodical" Header="{DynamicResource Str_Menu_Profile_Methodical}" IsCheckable="True" IsChecked="True" Click="MenuProfileMethodical_Click"/>
                    <MenuItem x:Name="MenuProfileClassic" Header="{DynamicResource Str_Menu_Profile_Classic}" IsCheckable="True" IsChecked="False" Click="MenuProfileClassic_Click"/>
                    <MenuItem x:Name="MenuProfileCustom" Header="{DynamicResource Str_Menu_Profile_Custom}" IsCheckable="True" IsChecked="False" IsEnabled="False"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource Str_Menu_WeightMethod}">
                        <MenuItem x:Name="MenuWeightColumnNorm" Header="{DynamicResource Str_Menu_Weight_ColNorm}" IsCheckable="True" Click="MenuWeightColumnNorm_Click"/>
                        <MenuItem x:Name="MenuWeightGeometric" Header="{DynamicResource Str_Menu_Weight_Geometric}" IsCheckable="True" Click="MenuWeightGeometric_Click"/>
                        <MenuItem x:Name="MenuWeightPowerIteration" Header="{DynamicResource Str_Menu_Weight_PowerIteration}" IsCheckable="True" Click="MenuWeightPowerIteration_Click"/>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource Str_Menu_LambdaMethod}">
                        <MenuItem x:Name="MenuLambdaColSum" Header="{DynamicResource Str_Menu_Lambda_ColSum}" IsCheckable="True" Click="MenuLambdaColSum_Click"/>
                        <MenuItem x:Name="MenuLambdaRowRatio" Header="{DynamicResource Str_Menu_Lambda_RowRatio}" IsCheckable="True" Click="MenuLambdaRowRatio_Click"/>
                        <MenuItem x:Name="MenuLambdaExact" Header="{DynamicResource Str_Menu_Lambda_Exact}" IsCheckable="True" Click="MenuLambdaExact_Click"/>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource Str_Menu_RiMode}">
                        <MenuItem x:Name="MenuRiEmpirical" Header="{DynamicResource Str_Menu_Ri_Empirical}" IsCheckable="True" Click="MenuRiEmpirical_Click"/>
                        <MenuItem x:Name="MenuRiTable" Header="{DynamicResource Str_Menu_Ri_Table}" IsCheckable="True" Click="MenuRiTable_Click"/>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource Str_Menu_ThresholdMode}">
                        <MenuItem x:Name="MenuThresholdUniform" Header="{DynamicResource Str_Menu_Threshold_Uniform}" IsCheckable="True" Click="MenuThresholdUniform_Click"/>
                        <MenuItem x:Name="MenuThresholdAdaptive" Header="{DynamicResource Str_Menu_Threshold_Adaptive}" IsCheckable="True" Click="MenuThresholdAdaptive_Click"/>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="{DynamicResource Str_Menu_Theme}">
                    <MenuItem.Icon>
                        <TextBlock Text="🎨" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </MenuItem.Icon>
                    <MenuItem x:Name="MenuThemeLight" Header="{DynamicResource Str_Menu_Theme_Light}" IsCheckable="True" IsChecked="True" Click="MenuThemeLight_Click"/>
                    <MenuItem x:Name="MenuThemeDark" Header="{DynamicResource Str_Menu_Theme_Dark}" IsCheckable="True" IsChecked="False" Click="MenuThemeDark_Click"/>
                </MenuItem>
                <MenuItem Header="{DynamicResource Str_Menu_Language}">
                    <MenuItem.Icon>
                        <TextBlock Text="🌐" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </MenuItem.Icon>
                    <MenuItem x:Name="MenuLangUk" Header="🇺🇦 Українська" IsCheckable="True" IsChecked="True" Click="MenuLangUk_Click"/>
                    <MenuItem x:Name="MenuLangEn" Header="🇬🇧 English" IsCheckable="True" IsChecked="False" Click="MenuLangEn_Click"/>
                </MenuItem>
            </MenuItem>

            <!-- Menu "Довідка" -->
            <MenuItem Header="{DynamicResource Str_Menu_Help}">
                <MenuItem Header="{DynamicResource Str_Menu_About}" InputGestureText="F1" Click="MenuHelpAbout_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="ℹ️" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <Grid Margin="20,12,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header & Presets -->
                <RowDefinition Height="*"/>    <!-- Main Navigation Tabs -->
                <RowDefinition Height="Auto"/> <!-- Bottom Action Bar -->
            </Grid.RowDefinitions>

        <!-- Top Header & Presets Bar -->
        <Border Grid.Row="0" CornerRadius="12" Padding="20,16" Margin="0,0,0,16" BorderThickness="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#0F172A" Opacity="0.04"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str_Main_HeaderTitle}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextDark}"/>
                        <Border x:Name="BadgeActiveProfile" Background="{DynamicResource PillConsistentBg}" BorderBrush="{DynamicResource PillConsistentBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="12,4,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtActiveProfile" Text="Профіль: Метод. рекомендації" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PillConsistentFg}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Str_Main_HeaderSubtitle}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Preset Toolbar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnPresetReference" Content="{DynamicResource Str_Main_BtnPresetRef}" ToolTip="{DynamicResource Str_Main_BtnPresetRef_Tip}" Style="{StaticResource SecondaryBtnStyle}" Margin="0,0,8,0" Click="BtnPresetReference_Click"/>
                    <Button x:Name="BtnPresetGpu2026" Content="{DynamicResource Str_Main_BtnPresetGpu}" ToolTip="{DynamicResource Str_Main_BtnPresetGpu_Tip}" Style="{StaticResource SecondaryBtnStyle}" Margin="0,0,8,0" Click="BtnPresetGpu2026_Click"/>
                    <Button x:Name="BtnResetEmpty" Content="{DynamicResource Str_Main_BtnReset}" ToolTip="{DynamicResource Str_Main_BtnReset_Tip}" Style="{StaticResource SecondaryBtnStyle}" Click="BtnResetEmpty_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Navigation Tabs -->
        <TabControl Grid.Row="1" x:Name="MainTabControl" Background="Transparent" BorderThickness="0" Margin="0,0,0,10" SelectionChanged="MainTabControl_SelectionChanged">
            <!-- TAB 1: Критерії та Альтернативи -->
            <TabItem Header="{DynamicResource Str_Main_Tab1}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Criteria Management Card -->
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="{DynamicResource Str_Main_CritCardTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextDark}"/>
                                        <TextBlock x:Name="TxtCritCount" Text="(4)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBlue}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Str_Main_CritCardDesc}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"/>

                                    <DataGrid x:Name="GridCriteria" Height="190" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                                              IsReadOnly="False"
                                              BeginningEdit="GridCriteria_BeginningEdit" CellEditEnding="GridCriteria_CellEditEnding"
                                              HeadersVisibility="Column" RowHeaderWidth="0"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Binding="{Binding Id, UpdateSourceTrigger=LostFocus}" Width="65" MinWidth="50"
                                                                EditingElementStyle="{StaticResource DataGridCellEditorTextBoxStyle}">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock Text="{DynamicResource Str_Main_ColCode}"/>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="Auto" MinWidth="140"
                                                                EditingElementStyle="{StaticResource DataGridCellEditorTextBoxStyle}">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock Text="{DynamicResource Str_Main_ColCritName}"/>
                                                </DataGridTextColumn.Header>
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                        <Setter Property="ToolTip" Value="{Binding Name}"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding Description, UpdateSourceTrigger=LostFocus}" Width="*" MinWidth="220"
                                                                EditingElementStyle="{StaticResource DataGridCellEditorTextBoxStyle}">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock Text="{DynamicResource Str_Main_ColCritDesc}"/>
                                                </DataGridTextColumn.Header>
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                        <Setter Property="ToolTip" Value="{Binding Description}"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button Content="{DynamicResource Str_Main_BtnAddCrit}" Style="{StaticResource SecondaryBtnStyle}" Margin="0,0,8,0" Click="BtnAddCriterion_Click"/>
                                        <Button Content="{DynamicResource Str_Main_BtnRemoveCrit}" Style="{StaticResource SecondaryBtnStyle}" Click="BtnRemoveCriterion_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Alternatives Management Card -->
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="{DynamicResource Str_Main_AltCardTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextDark}"/>
                                        <TextBlock x:Name="TxtAltCount" Text="(5)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBlue}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Str_Main_AltCardDesc}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"/>

                                    <DataGrid x:Name="GridAlternatives" Height="190" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                                              IsReadOnly="False"
                                              BeginningEdit="GridAlternatives_BeginningEdit" CellEditEnding="GridAlternatives_CellEditEnding"
                                              HeadersVisibility="Column" RowHeaderWidth="0"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Binding="{Binding Id, UpdateSourceTrigger=LostFocus}" Width="65" MinWidth="50"
                                                                EditingElementStyle="{StaticResource DataGridCellEditorTextBoxStyle}">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock Text="{DynamicResource Str_Main_ColCode}"/>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="Auto" MinWidth="160"
                                                                EditingElementStyle="{StaticResource DataGridCellEditorTextBoxStyle}">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock Text="{DynamicResource Str_Main_ColAltName}"/>
                                                </DataGridTextColumn.Header>
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                        <Setter Property="ToolTip" Value="{Binding Name}"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding Description, UpdateSourceTrigger=LostFocus}" Width="*" MinWidth="220"
                                                                EditingElementStyle="{StaticResource DataGridCellEditorTextBoxStyle}">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock Text="{DynamicResource Str_Main_ColAltDesc}"/>
                                                </DataGridTextColumn.Header>
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                        <Setter Property="ToolTip" Value="{Binding Description}"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button Content="{DynamicResource Str_Main_BtnAddAlt}" Style="{StaticResource SecondaryBtnStyle}" Margin="0,0,8,0" Click="BtnAddAlternative_Click"/>
                                        <Button Content="{DynamicResource Str_Main_BtnRemoveAlt}" Style="{StaticResource SecondaryBtnStyle}" Click="BtnRemoveAlternative_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Saaty Scale Reference Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str_Scale_Title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextDark}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="{DynamicResource Str_Scale_Point1}" FontSize="12" Foreground="{DynamicResource TextDark}" Margin="0,2"/>
                                        <TextBlock Text="{DynamicResource Str_Scale_Point3}" FontSize="12" Foreground="{DynamicResource TextDark}" Margin="0,2"/>
                                        <TextBlock Text="{DynamicResource Str_Scale_Point5}" FontSize="12" Foreground="{DynamicResource TextDark}" Margin="0,2"/>
                                        <TextBlock Text="{DynamicResource Str_Scale_Point7}" FontSize="12" Foreground="{DynamicResource TextDark}" Margin="0,2"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{DynamicResource Str_Scale_Point9}" FontSize="12" Foreground="{DynamicResource TextDark}" Margin="0,2"/>
                                        <TextBlock Text="{DynamicResource Str_Scale_PointEven}" FontSize="12" Foreground="{DynamicResource TextDark}" Margin="0,2"/>
                                        <TextBlock Text="{DynamicResource Str_Scale_PointReciprocal}" FontSize="12" Foreground="{DynamicResource TextDark}" Margin="0,2"/>
                                        <TextBlock Text="{DynamicResource Str_Scale_Tip}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBlue}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: Порівняння критеріїв -->
            <TabItem Header="{DynamicResource Str_Main_Tab2}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,0">
                    <StackPanel>
                        <!-- Criteria Matrix Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Str_Main_CritMatrixTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextDark}"/>
                                        <TextBlock Text="{DynamicResource Str_Main_CritMatrixDesc}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>

                                    <!-- Quick Status Pill & Progress -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtCritJudgedProgress" Text="Заповнено 6 з 6 порівнянь" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Border x:Name="PillCritStatus" Background="{DynamicResource PillConsistentBg}" BorderBrush="{DynamicResource PillConsistentBorder}" BorderThickness="1" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtCritStatus" Text="Узгоджено (CR = 1.7% ≤ 10%)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PillConsistentFg}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Dynamic Matrix Container -->
                                <Border Background="{DynamicResource MatrixContainerBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <Grid x:Name="GridCritMatrixContainer"/>
                                    </ScrollViewer>
                                </Border>

                                <!-- Inconsistency Hint for Criteria -->
                                <Border x:Name="BorderCritInconsistentHint" Visibility="Collapsed" Background="#1AF59E0B" BorderBrush="{DynamicResource WarningOrange}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💡 " FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtCritInconsistentHint" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource WarningOrange}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Live Weights & Diagnostics -->
                                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource Str_Main_CritWeightsTitle}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextDark}" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="TxtCritWeightsPreview" Text="w = [P: 0.365, F: 0.234, A: 0.124, C: 0.278]" FontSize="13" Foreground="{DynamicResource PrimaryBlue}" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" TextBlock.TextAlignment="Right">
                                            <TextBlock x:Name="TxtCritLambdaCI" Text="λmax = 4.0458 | CI = 0.0153" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock x:Name="TxtCritRIRatio" Text="RI(табл) = 0.90 | CR = 0.0170 (1.7%)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessGreen}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: Оцінка альтернатив -->
            <TabItem Header="{DynamicResource Str_Main_Tab3}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Str_Main_AltMatricesTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextDark}"/>
                                        <TextBlock Text="{DynamicResource Str_Main_AltMatricesDesc}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>

                                    <!-- Quick Status Pill & Progress for Alternative Matrix -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtAltJudgedProgress" Text="Заповнено 10 з 10 порівнянь" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Border x:Name="PillAltStatus" Background="{DynamicResource PillConsistentBg}" BorderBrush="{DynamicResource PillConsistentBorder}" BorderThickness="1" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtAltStatus" Text="Узгоджено (CR = 2.6%)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PillConsistentFg}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Criteria Tab Strip for Alternatives -->
                                <WrapPanel x:Name="PanelCritSelectors" Margin="0,0,0,12"/>

                                <!-- Dynamic Matrix Container for Alternatives -->
                                <Border Background="{DynamicResource MatrixContainerBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <Grid x:Name="GridAltMatrixContainer"/>
                                    </ScrollViewer>
                                </Border>

                                <!-- Inconsistency Hint for Alternatives -->
                                <Border x:Name="BorderAltInconsistentHint" Visibility="Collapsed" Background="#1AF59E0B" BorderBrush="{DynamicResource WarningOrange}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💡 " FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtAltInconsistentHint" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource WarningOrange}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Live Local Priorities for selected criterion -->
                                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="TxtAltLocalPriTitle" Text="Локальні пріоритети альтернатив за обраним критерієм:" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextDark}" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="TxtAltLocalPriPreview" Text="A1: 0.045, A2: 0.139, A3: 0.213, A4: 0.278, A5: 0.325" FontSize="13" Foreground="{DynamicResource PrimaryBlue}" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" TextBlock.TextAlignment="Right">
                                            <TextBlock x:Name="TxtAltLambdaCI" Text="λmax = 5.1248 | CI = 0.0312" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock x:Name="TxtAltRIRatio" Text="RI = 1.12 | CR = 0.0278 (2.8%)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessGreen}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="16,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#0F172A" Opacity="0.04"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtBottomStatus" Text="Готово до розрахунку: 4 критерії, 5 альтернатив." FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}"/>
                    <TextBlock x:Name="TxtActiveProfileDesc" Text="Профіль: За метод. реком. • Нормалізація стовпців • Σ(ColSum_j · w_j) • Емпіричний RI • CR ≤ 10%" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>

                <Button Grid.Column="1" Content="{DynamicResource Str_Main_BtnCalculate}" Style="{StaticResource PrimaryBtnStyle}" Height="38" Padding="20,0" FontSize="14" Click="BtnCalculate_Click"/>
            </Grid>
        </Border>
    </Grid>
    </DockPanel>
</Window>
