<Window x:Class="MAI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_About_Title}"
        Width="580"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="Resources/app_icon.ico"
        Background="{DynamicResource AppBackground}">
    <Border Padding="20">
        <StackPanel>
            <!-- Header Card / Banner -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon / Badge -->
                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="10" Background="{DynamicResource BadgeBg}" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Image Source="Resources/app_icon.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title & Discipline -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str_About_SystemName}" 
                                   FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextDark}" TextWrapping="Wrap" LineHeight="20"/>
                        <TextBlock Text="{DynamicResource Str_About_Discipline}" 
                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBlue}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Middle Card: Description & Key Features -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_About_KeyFeaturesTitle}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextDark}" Margin="0,0,0,8"/>
                    
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="{DynamicResource Str_About_Feature1}" FontSize="12" Foreground="{DynamicResource TextDark}" Margin="0,2.5"/>
                        <TextBlock Text="{DynamicResource Str_About_Feature2}" FontSize="12" Foreground="{DynamicResource TextDark}" Margin="0,2.5"/>
                        <TextBlock Text="{DynamicResource Str_About_Feature3}" FontSize="12" Foreground="{DynamicResource TextDark}" Margin="0,2.5"/>
                        <TextBlock Text="{DynamicResource Str_About_Feature4}" FontSize="12" Foreground="{DynamicResource TextDark}" Margin="0,2.5"/>
                        <TextBlock Text="{DynamicResource Str_About_Feature5}" FontSize="12" Foreground="{DynamicResource TextDark}" Margin="0,2.5"/>
                        <TextBlock Text="{DynamicResource Str_About_Feature6}" FontSize="12" Foreground="{DynamicResource TextDark}" Margin="0,2.5"/>
                        <TextBlock Text="{DynamicResource Str_About_Feature7}" FontSize="12" Foreground="{DynamicResource TextDark}" Margin="0,2.5"/>
                        <TextBlock Text="{DynamicResource Str_About_Feature8}" FontSize="12" Foreground="{DynamicResource TextDark}" Margin="0,2.5"/>
                        <TextBlock Text="{DynamicResource Str_About_Feature9}" FontSize="12" Foreground="{DynamicResource TextDark}" Margin="0,2.5"/>
                        <TextBlock Text="{DynamicResource Str_About_Feature10}" FontSize="12" Foreground="{DynamicResource TextDark}" Margin="0,2.5"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Bottom Card: Version, Platform & Close Button -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,0" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtAppVersion" Text="Версія 1.3.1" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryBlue}"/>
                        <TextBlock Text="{DynamicResource Str_About_Platform}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="{DynamicResource Str_About_BtnClose}" Style="{StaticResource PrimaryBtnStyle}" Height="34" Padding="20,0" IsDefault="True" IsCancel="True" Click="BtnClose_Click"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
