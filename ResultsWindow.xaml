<Window x:Class="MAI.ResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MAI"
        mc:Ignorable="d"
        Title="Результати багатокритеріального аналізу МАІ (Сааті)" 
        Height="750" Width="1100"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterOwner"
        Icon="Resources/app_icon.ico"
        Background="{DynamicResource AppBackground}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Summary Banner -->
            <RowDefinition Height="*"/>    <!-- Tabs with Compact & Detailed Views -->
            <RowDefinition Height="Auto"/> <!-- Bottom Buttons -->
        </Grid.RowDefinitions>

        <!-- Top Summary Banner -->
        <Border Grid.Row="0" CornerRadius="12" Padding="20,16" Margin="0,0,0,16" BorderThickness="1" Background="{DynamicResource BannerBg}" BorderBrush="{DynamicResource BannerBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Підсумкові результати методу аналізу ієрархій" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BannerTitle}"/>
                    <TextBlock x:Name="TxtBannerSubtitle" Text="Ієрархічний синтез за шкалою Сааті: Мета → Критерії → Альтернативи" FontSize="13" Foreground="{DynamicResource BannerSubtitle}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Winner & Consistency Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Consistency Badge -->
                    <Border x:Name="BadgeConsistency" Background="{DynamicResource PillConsistentBg}" BorderBrush="{DynamicResource PillConsistentBorder}" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,10,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Ієрархічна узгодженість" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PillConsistentFg}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtHierarchicalCR" Text="CR = 1.9%" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PillConsistentFg}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Winner Badge -->
                    <Border x:Name="BadgeWinner" Background="{DynamicResource PrimaryBlue}" CornerRadius="8" Padding="16,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🏆 Оптимальний вибір" FontSize="11" FontWeight="SemiBold" Foreground="#EFF6FF" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtWinnerName" Text="Альтернатива 1" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabs: Compact Results vs Detailed Analysis -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,0,0,12">
            <!-- TAB 1: Компактні результати -->
            <TabItem Header="📊 Компактний підсумок (Рейтинг)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,2,0,0">
                    <StackPanel>
                        <!-- Card 1: Leaderboard Table -->
                        <Border x:Name="CardRankingContainer" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Підсумковий рейтинг альтернатив" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextDark}" Margin="0,0,0,4"/>
                                <TextBlock Text="Ранжування виконано за глобальними пріоритетами ієрархічного синтезу (Pi = Σ Lij · wj)." FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,14"/>

                                <ItemsControl x:Name="ListRankings">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="1" BorderBrush="{DynamicResource BorderColor}" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="42"/>  <!-- Rank Badge -->
                                                        <ColumnDefinition Width="*"/>   <!-- Name & Description -->
                                                        <ColumnDefinition Width="110"/> <!-- Percent -->
                                                        <ColumnDefinition Width="170"/> <!-- Progress Bar -->
                                                        <ColumnDefinition Width="115"/> <!-- Status Pill -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Rank Badge -->
                                                    <Border Grid.Column="0" Background="{Binding RankBackground}" CornerRadius="6" Width="34" Height="34" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding RankText}" FontWeight="Bold" FontSize="14" Foreground="{Binding RankForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Name & Description -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,12,0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextDark}"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <!-- Percent -->
                                                    <TextBlock Grid.Column="2" Text="{Binding PriorityPercentText}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryBlue}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>

                                                    <!-- Visual Bar -->
                                                    <Grid Grid.Column="3" VerticalAlignment="Center" Margin="0,0,14,0">
                                                        <Border Background="{DynamicResource MatrixContainerBg}" CornerRadius="5" Height="12"/>
                                                        <ProgressBar Value="{Binding PriorityPercent, Mode=OneWay}" Maximum="100" Height="12" Foreground="{Binding BarBrush}" Background="Transparent" BorderThickness="0"/>
                                                    </Grid>

                                                    <!-- Status Badge -->
                                                    <Border Grid.Column="4" Background="{Binding BadgeBackground}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding BadgeForeground}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Criteria Weights Distribution -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Розподіл вагових коефіцієнтів критеріїв" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextDark}" Margin="0,0,0,4"/>
                                <TextBlock Text="Важливість критеріїв визначено на основі нормалізованої матриці попарних порівнянь." FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,12"/>

                                <ItemsControl x:Name="ListCriteriaCards">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource MatrixContainerBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextDark}"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding WeightPercentText}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource PrimaryBlue}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Analytical Conclusion / Recommendation -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Висновки та аналітичні рекомендації" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextDark}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtRecommendation" Text="Текст аналітичного висновку..." FontSize="13" LineHeight="20" Foreground="{DynamicResource TextDark}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: Детальний аналіз та матриці -->
            <TabItem Header="🔬 Детальний аналіз та матриці">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,2,0,0">
                    <StackPanel>
                        <!-- Synthesis Matrix Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Матриця ієрархічного синтезу (P = L · w)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextDark}" Margin="0,0,0,4"/>
                                <TextBlock Text="Для кожної альтернативи наведено локальні пріоритети за критеріями (Lij) та їхній зважений внесок у підсумковий бал (Lij · wj)." FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,12"/>

                                <DataGrid x:Name="GridSynthesis" AutoGenerateColumns="True" MaxHeight="300" HeadersVisibility="Column" SelectionMode="Single"
                                          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                          AutoGeneratingColumn="DataGrid_AutoGeneratingColumn"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>

                        <!-- Consistency Table Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Показники узгодженості суджень (λmax, CI, RI, CR)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextDark}" Margin="0,0,0,4"/>
                                <TextBlock Text="Оцінка логічної несуперечливості експертних оцінок. Згідно із методикою Сааті, прийнятною вважається умова CR ≤ 0.10 (10%)." FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,12"/>

                                <DataGrid x:Name="GridConsistency" AutoGenerateColumns="False" MaxHeight="300" HeadersVisibility="Column" SelectionMode="Single"
                                          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Матриця порівнянь" Binding="{Binding MatrixName}" Width="190"/>
                                        <DataGridTextColumn Header="Розмір (n)" Binding="{Binding Dimension}" Width="75"/>
                                        <DataGridTextColumn Header="λmax" Binding="{Binding LambdaMax}" Width="75"/>
                                        <DataGridTextColumn Header="CI" Binding="{Binding CI}" Width="75"/>
                                        <DataGridTextColumn Header="RI (табл)" Binding="{Binding RITable}" Width="75"/>
                                        <DataGridTextColumn Header="RI (емп)" Binding="{Binding RIEmpirical}" Width="75"/>
                                        <DataGridTextColumn Header="CR (табл)" Binding="{Binding CRTable}" Width="105"/>
                                        <DataGridTextColumn Header="CR (емп)" Binding="{Binding CREmpirical}" Width="105"/>
                                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110"/>
                                        <DataGridTextColumn Header="Вердикт" Binding="{Binding Verdict}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Matrix View Details (Selectable) -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="Детальний перегляд розрахунку матриць" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextDark}"/>
                                        <TextBlock Text="Вихідна матриця попарних порівнянь, нормалізована матриця та вектор пріоритетів." FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>

                                    <ComboBox Grid.Column="1" x:Name="ComboMatrixSelector" Width="260" Height="30" SelectionChanged="ComboMatrixSelector_SelectionChanged" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock x:Name="TxtSelectedMatrixInfo" Text="Інформація про обрану матрицю..." FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBlue}" Margin="0,0,0,8"/>
                                <DataGrid x:Name="GridSelectedMatrix" AutoGenerateColumns="True" MaxHeight="280" HeadersVisibility="Column" SelectionMode="Single"
                                          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                          AutoGeneratingColumn="DataGrid_AutoGeneratingColumn"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>

                        <!-- Export & Copy Report Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Експорт результатів дослідження" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextDark}"/>
                                    <TextBlock Text="Формування повного текстового звіту з усіма коефіцієнтами для курсової чи лабораторної роботи." FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="📋 Копіювати звіт у буфер" Style="{StaticResource SecondaryBtnStyle}" Margin="0,0,8,0" Click="BtnCopyReport_Click"/>
                                    <Button Content="💾 Зберегти звіт у TXT" Style="{StaticResource SecondaryBtnStyle}" Click="BtnSaveReport_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: Аналіз чутливості (Sensitivity Analysis) -->
            <TabItem Header="📈 Аналіз чутливості (Sensitivity)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,2,0,0">
                    <StackPanel>
                        <!-- Card 1: Criterion Selection & Interactive Slider Controls -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Дослідження стійкості рейтингу до ваги критерію" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextDark}" Margin="0,0,0,4"/>
                                        <TextBlock Text="Моделювання варіювання ваги обраного критерію t ∈ [0, 1] із пропорційним масштабуванням решти критеріїв: Pi(t) = αi · t + βi." FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>

                                    <!-- Criterion Selector ComboBox -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Критерій:" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextDark}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="ComboSensitivityCriterion" Width="240" Height="32" SelectionChanged="ComboSensitivityCriterion_SelectionChanged" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Separator Margin="0,12,0,12" Background="{DynamicResource BorderColor}"/>

                                <!-- Interactive Slider and Real-time indicators -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <Border Background="{DynamicResource PillConsistentBg}" BorderBrush="{DynamicResource PillConsistentBorder}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                            <TextBlock x:Name="TxtSensBaselineWeight" Text="Базова вага: 27.8%" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PillConsistentFg}"/>
                                        </Border>
                                        <Border Background="{DynamicResource BadgeBg}" CornerRadius="6" Padding="8,4">
                                            <TextBlock x:Name="TxtSensCurrentWeight" Text="Поточна вага t = 27.8%" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BadgeFg}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Slider -->
                                    <Slider Grid.Column="1" x:Name="SliderSensitivityWeight" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" Value="27.8" TickFrequency="10" IsSnapToTickEnabled="False" VerticalAlignment="Center" ValueChanged="SliderSensitivityWeight_ValueChanged"/>

                                    <!-- Reset to Baseline Button -->
                                    <Button Grid.Column="2" x:Name="BtnResetSensWeight" Content="🔄 Скинути до базової" Style="{StaticResource SecondaryBtnStyle}" Margin="12,0,0,0" Padding="12,4" Height="32" Click="BtnResetSensWeight_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Two Columns: Sensitivity Vector Plot (Left) & Real-time Ranking at t (Right) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Graphic Plot -->
                            <Border x:Name="SensitivityPlotContainer" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Графік чутливості пріоритетів Pi(t)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextDark}"/>
                                        <TextBlock Grid.Column="1" x:Name="TxtSensPlotLeader" Text="Поточний лідер: RTX 5060 Ti" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBlue}"/>
                                    </Grid>

                                    <!-- Canvas Plot Container -->
                                    <Border x:Name="PlotBorder" Background="{DynamicResource MatrixContainerBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="6" Height="340" SizeChanged="PlotBorder_SizeChanged">
                                        <Canvas x:Name="CanvasSensitivityPlot" ClipToBounds="True"/>
                                    </Border>

                                    <!-- Chart Legend -->
                                    <ItemsControl x:Name="ListSensLegend" Margin="0,10,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Background="{DynamicResource CardBg}" CornerRadius="6" Padding="6,3" Margin="0,0,8,4">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Rectangle Width="14" Height="10" RadiusX="2" RadiusY="2" Fill="{Binding ColorBrush}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Right: Dynamic Real-time Ranking at current t -->
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Рейтинг альтернатив при поточному t" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextDark}" Margin="0,0,0,2"/>
                                    <TextBlock Text="Динамічна зміна позицій при поточному значенні ваги." FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"/>

                                    <ItemsControl x:Name="ListSensDynamicRankings">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderThickness="1" BorderBrush="{DynamicResource BorderColor}" Background="{DynamicResource CardBg}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="34"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" Background="{Binding RankBackground}" CornerRadius="4" Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding RankText}" FontWeight="Bold" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,8,0">
                                                            <TextBlock Text="{Binding AlternativeName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextDark}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding DeltaText}" FontSize="10" Foreground="{Binding DeltaBrush}"/>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="2" Text="{Binding PriorityPercentText}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryBlue}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Card 3: Leadership Intervals & Analytical Robustness Assessment -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Аналіз зон лідерства та стійкості вибору (Robustness Assessment)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextDark}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtSensStabilityComment" Text="Оцінка стабільності оптимального вибору..." FontSize="13" LineHeight="19" Foreground="{DynamicResource TextDark}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                <TextBlock Text="Діапазони домінування альтернатив на відрізку [0; 1]:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                <ItemsControl x:Name="ListSensLeadershipIntervals">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource MatrixContainerBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,6">
                                                <TextBlock Text="{Binding DisplayText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextDark}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Critical Intersection Points Table -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Критичні точки перетину функцій (точки інверсії ранжиру)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextDark}" Margin="0,0,0,4"/>
                                <TextBlock Text="Значення ваги критерію t*, при яких дві альтернативи мають однаковий глобальний пріоритет (α1 · t + β1 = α2 · t + β2)." FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"/>

                                <DataGrid x:Name="GridCriticalPoints" AutoGenerateColumns="False" MaxHeight="220" HeadersVisibility="Column" SelectionMode="Single"
                                          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Альтернатива 1" Binding="{Binding Alt1Name}" Width="160"/>
                                        <DataGridTextColumn Header="Альтернатива 2" Binding="{Binding Alt2Name}" Width="160"/>
                                        <DataGridTextColumn Header="Критична вага t*" Binding="{Binding WeightTText}" Width="120"/>
                                        <DataGridTextColumn Header="Пріоритет P*" Binding="{Binding PriorityPText}" Width="110"/>
                                        <DataGridTextColumn Header="Тип інверсії" Binding="{Binding ChangeTypeText}" Width="150"/>
                                        <DataGridTextColumn Header="Опис" Binding="{Binding EventDescription}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14,10">
            <Grid>
                <TextBlock x:Name="TxtResultsStatus" Text="Розрахунок виконано математичним рушієм AHP (.NET 10)" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnExport" Content="📥 Експорт таблиць та графіків ▾" Style="{StaticResource SecondaryBtnStyle}" Margin="0,0,10,0" Click="BtnExport_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ExportContextMenu">
                                <MenuItem Header="📊 Таблиці у CSV (Excel)" Click="MenuExportCsv_Click"/>
                                <MenuItem Header="📝 Таблиці у Markdown (.md)" Click="MenuExportMarkdown_Click"/>
                                <MenuItem Header="🌐 Таблиці у HTML (Word)" Click="MenuExportHtml_Click"/>
                                <Separator/>
                                <MenuItem Header="🖼️ Графік рейтингу (PNG, 192 DPI)" Click="MenuExportRankingPng_Click"/>
                                <MenuItem Header="📈 Графік чутливості (PNG, 192 DPI)" Click="MenuExportSensitivityPng_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="Закрити вікно" Style="{StaticResource PrimaryBtnStyle}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
