<Window x:Class="MAI.ResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MAI"
        mc:Ignorable="d"
        Title="Результати багатокритеріального аналізу МАІ (Сааті)" 
        Height="740" Width="1000"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryBlueHover" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="PrimaryBluePressed" Color="#1E40AF"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>

        <!-- Base TextBlock Style -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- Modern Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#0F172A" Opacity="0.05"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Primary Button -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBlueHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBluePressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Styles -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Height" Value="36"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Summary Banner -->
            <RowDefinition Height="*"/>    <!-- Tabs with Compact & Detailed Views -->
            <RowDefinition Height="Auto"/> <!-- Bottom Buttons -->
        </Grid.RowDefinitions>

        <!-- Top Summary Banner -->
        <Border Grid.Row="0" CornerRadius="12" Padding="20,16" Margin="0,0,0,16" BorderThickness="1" Background="#EFF6FF" BorderBrush="#BFDBFE">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Підсумкові результати методу аналізу ієрархій" FontSize="20" FontWeight="Bold" Foreground="#1E3A8A"/>
                    <TextBlock Text="Ієрархічний синтез за шкалою Сааті: Мета → Критерії → Альтернативи" FontSize="13" Foreground="#475569" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Winner & Consistency Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Consistency Badge -->
                    <Border x:Name="BadgeConsistency" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,10,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Ієрархічна узгодженість" FontSize="11" FontWeight="SemiBold" Foreground="#166534" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtHierarchicalCR" Text="CR = 1.9%" FontSize="16" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Winner Badge -->
                    <Border x:Name="BadgeWinner" Background="#2563EB" CornerRadius="8" Padding="16,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🏆 Оптимальний вибір" FontSize="11" FontWeight="SemiBold" Foreground="#EFF6FF" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtWinnerName" Text="Альтернатива 1" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabs: Compact Results vs Detailed Analysis -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,0,0,12">
            <!-- TAB 1: Компактні результати -->
            <TabItem Header="📊 Компактний підсумок (Рейтинг)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <!-- Card 1: Leaderboard Table -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Підсумковий рейтинг альтернатив" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                                <TextBlock Text="Ранжування виконано за глобальними пріоритетами ієрархічного синтезу (Pi = Σ Lij · wj)." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,14"/>

                                <ItemsControl x:Name="ListRankings">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="1" BorderBrush="#E2E8F0" Background="#FFFFFF" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48"/>  <!-- Rank Badge -->
                                                        <ColumnDefinition Width="2*"/>  <!-- Name & Description -->
                                                        <ColumnDefinition Width="90"/>  <!-- Percent -->
                                                        <ColumnDefinition Width="3*"/>  <!-- Progress Bar -->
                                                        <ColumnDefinition Width="110"/> <!-- Status Pill -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Rank Badge -->
                                                    <Border Grid.Column="0" Background="{Binding RankBackground}" CornerRadius="6" Width="36" Height="36" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding RankText}" FontWeight="Bold" FontSize="15" Foreground="{Binding RankForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Name & Description -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#1E293B"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <!-- Percent -->
                                                    <TextBlock Grid.Column="2" Text="{Binding PriorityPercentText}" FontWeight="Bold" FontSize="15" Foreground="#1E40AF" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>

                                                    <!-- Visual Bar -->
                                                    <Grid Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <Border Background="#F1F5F9" CornerRadius="5" Height="14"/>
                                                        <ProgressBar Value="{Binding PriorityPercent, Mode=OneWay}" Maximum="100" Height="14" Foreground="{Binding BarBrush}" Background="Transparent" BorderThickness="0"/>
                                                    </Grid>

                                                    <!-- Status Badge -->
                                                    <Border Grid.Column="4" Background="{Binding BadgeBackground}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding BadgeForeground}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Criteria Weights Distribution -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Розподіл вагових коефіцієнтів критеріїв" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                                <TextBlock Text="Важливість критеріїв визначено на основі нормалізованої матриці попарних порівнянь." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,12"/>

                                <ItemsControl x:Name="ListCriteriaCards">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                                    <TextBlock Text="{Binding WeightPercentText}" FontWeight="Bold" FontSize="18" Foreground="#2563EB" Margin="0,4,0,2"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Analytical Conclusion / Recommendation -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Висновки та аналітичні рекомендації" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtRecommendation" Text="Текст аналітичного висновку..." FontSize="13" LineHeight="20" Foreground="#334155" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: Детальний аналіз та матриці -->
            <TabItem Header="🔬 Детальний аналіз та матриці">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <!-- Synthesis Matrix Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Матриця ієрархічного синтезу (P = L · w)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                                <TextBlock Text="Для кожної альтернативи наведено локальні пріоритети за критеріями (Lij) та їхній зважений внесок у підсумковий бал (Lij · wj)." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,12"/>

                                <DataGrid x:Name="GridSynthesis" AutoGenerateColumns="True" MaxHeight="280" HeadersVisibility="Column" SelectionMode="Single"/>
                            </StackPanel>
                        </Border>

                        <!-- Consistency Table Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Показники узгодженості суджень (λmax, CI, RI, CR)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                                <TextBlock Text="Оцінка логічної несуперечливості експертних оцінок. Згідно із методикою Сааті, прийнятною вважається умова CR ≤ 0.10 (10%)." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,12"/>

                                <DataGrid x:Name="GridConsistency" AutoGenerateColumns="False" MaxHeight="280" HeadersVisibility="Column" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Матриця порівнянь" Binding="{Binding MatrixName}" Width="2*"/>
                                        <DataGridTextColumn Header="Розмір (n)" Binding="{Binding Dimension}" Width="75"/>
                                        <DataGridTextColumn Header="λmax" Binding="{Binding LambdaMax}" Width="75"/>
                                        <DataGridTextColumn Header="CI" Binding="{Binding CI}" Width="75"/>
                                        <DataGridTextColumn Header="RI (табл)" Binding="{Binding RITable}" Width="75"/>
                                        <DataGridTextColumn Header="RI (емп)" Binding="{Binding RIEmpirical}" Width="75"/>
                                        <DataGridTextColumn Header="CR (табл)" Binding="{Binding CRTable}" Width="105"/>
                                        <DataGridTextColumn Header="CR (емп)" Binding="{Binding CREmpirical}" Width="105"/>
                                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110"/>
                                        <DataGridTextColumn Header="Вердикт" Binding="{Binding Verdict}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Matrix View Details (Selectable) -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Детальний перегляд розрахунку матриць" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                                        <TextBlock Text="Вихідна матриця попарних порівнянь, нормалізована матриця та вектор пріоритетів." FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>

                                    <ComboBox Grid.Column="1" x:Name="ComboMatrixSelector" Width="260" Height="30" SelectionChanged="ComboMatrixSelector_SelectionChanged" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock x:Name="TxtSelectedMatrixInfo" Text="Інформація про обрану матрицю..." FontSize="13" FontWeight="SemiBold" Foreground="#1E40AF" Margin="0,0,0,8"/>
                                <DataGrid x:Name="GridSelectedMatrix" AutoGenerateColumns="True" MaxHeight="260" HeadersVisibility="Column" SelectionMode="Single"/>
                            </StackPanel>
                        </Border>

                        <!-- Export & Copy Report Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Експорт результатів дослідження" FontWeight="Bold" FontSize="14" Foreground="#1E293B"/>
                                    <TextBlock Text="Формування повного текстового звіту з усіма коефіцієнтами для курсової чи лабораторної роботи." FontSize="12" Foreground="#64748B"/>
                                </StackPanel>

                                <Button Grid.Column="1" Content="📋 Копіювати звіт у буфер" Style="{StaticResource SecondaryBtnStyle}" Margin="0,0,8,0" Click="BtnCopyReport_Click"/>
                                <Button Grid.Column="2" Content="💾 Зберегти звіт у TXT" Style="{StaticResource SecondaryBtnStyle}" Click="BtnSaveReport_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10">
            <Grid>
                <TextBlock Text="Розрахунок виконано математичним рушієм AHP (.NET 10)" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <Button Content="Закрити вікно" Style="{StaticResource PrimaryBtnStyle}" HorizontalAlignment="Right" Click="BtnClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
